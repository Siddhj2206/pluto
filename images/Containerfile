ARG BASE_IMAGE
FROM ${BASE_IMAGE}

ARG APT_SNAPSHOT
ARG APT_PACKAGES
ARG SOURCE_DATE_EPOCH

ENV DEBIAN_FRONTEND=noninteractive
# SOURCE_DATE_EPOCH comes from the apt snapshot pin (images/pins.yaml). Every
# timestamp is clamped to it at assembly, so the artifact carries no build
# clock.
ENV SOURCE_DATE_EPOCH=${SOURCE_DATE_EPOCH}

# Pin apt to the dated snapshot from the pins manifest (images/pins.yaml) so
# package versions do not float. apt detects the Snapshot field on Ubuntu 24.04
# and fetches through snapshot.ubuntu.com, which is HTTPS-only — but the minimal
# base image has no CA bundle until ca-certificates is installed. Bootstrap only
# the ca-certificates fetch with peer verification off for the snapshot host;
# apt still verifies the archive's signed InRelease against the pinned keyring,
# so the trust anchor is the GPG signature, not TLS. Once ca-certificates is
# installed the remaining packages fetch over verified TLS.
RUN sed -i "/^Signed-By:/a Snapshot: ${APT_SNAPSHOT}" \
      /etc/apt/sources.list.d/ubuntu.sources \
 && apt-get -o Acquire::https::snapshot.ubuntu.com::Verify-Peer=false update \
 && apt-get -o Acquire::https::snapshot.ubuntu.com::Verify-Peer=false install -y --no-install-recommends ca-certificates \
 && apt-get install -y --no-install-recommends ${APT_PACKAGES} \
 && rm -rf /var/lib/apt/lists/*

# The box's human: one non-root user with linger so the user manager runs.
RUN userdel -r ubuntu 2>/dev/null || true \
 && useradd --create-home --uid 1000 --shell /bin/bash dev \
 && passwd -d dev \
 && install -d -o dev -g dev -m 0700 /home/dev/.ssh \
 && mkdir -p /var/lib/systemd/linger \
 && touch /var/lib/systemd/linger/dev

# [tools] apt installs run in a user unit as `dev`, so dev needs passwordless
# sudo to reach apt; the rule is validated as the image is built.
RUN printf 'dev ALL=(ALL) NOPASSWD:ALL\n' > /etc/sudoers.d/dev \
 && chown root:root /etc/sudoers.d/dev \
 && chmod 0440 /etc/sudoers.d/dev \
 && visudo -cf /etc/sudoers.d/dev

# Provision-installed tools land in the box user's bin dirs (bun, pipx, uv).
# pam_env reads /etc/environment for every ssh session — interactive or
# `ssh box cmd` — so they get the same PATH the agent gives hooks, services,
# and jobs.
RUN printf 'PATH="/home/dev/.bun/bin:/home/dev/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/games:/usr/local/games:/snap/bin"\n' > /etc/environment

# sshd listens on vsock as well as loopback. Host keys are not baked: random
# keys would make every rebuild differ, so the image ships none and each box
# generates its own on first start. The drop-in resets ssh.service's
# ExecStartPre list so ssh-keygen runs before the existing `sshd -t` check,
# which fails when no host keys exist.
RUN mkdir -p /etc/systemd/system/ssh.socket.d \
 && printf '[Socket]\nListenStream=vsock::22\n' > /etc/systemd/system/ssh.socket.d/10-vsock.conf \
 && rm -f /etc/ssh/ssh_host_* \
 && mkdir -p /etc/systemd/system/ssh.service.d \
 && printf '[Service]\nExecStartPre=\nExecStartPre=/usr/bin/ssh-keygen -A\nExecStartPre=/usr/sbin/sshd -t\n' \
      > /etc/systemd/system/ssh.service.d/10-hostkeys.conf \
 && mkdir -p /etc/systemd/system/sockets.target.wants \
 && ln -sf /usr/lib/systemd/system/ssh.socket /etc/systemd/system/sockets.target.wants/ssh.socket

# Egress through the rootless slirp4netns address plan (10.0.2.0/24).
# resolv.conf is written at boot via tmpfiles: podman shadows the file at
# build time, and nothing else manages it in this minimal image.
RUN printf 'f+ /etc/resolv.conf 0644 root root - nameserver 10.0.2.3\n' \
      > /etc/tmpfiles.d/pluto-resolv.conf \
 && printf '[Match]\nName=en* eth*\n\n[Network]\nAddress=10.0.2.15/24\nGateway=10.0.2.2\nDNS=10.0.2.3\n' \
      > /etc/systemd/network/20-pluto.network \
 && mkdir -p /etc/systemd/system/multi-user.target.wants \
 && ln -sf /usr/lib/systemd/system/systemd-networkd.service /etc/systemd/system/multi-user.target.wants/systemd-networkd.service

# machine-id stays empty so systemd mints one per boot.
RUN truncate -s 0 /etc/machine-id && rm -f /var/lib/dbus/machine-id

# Pause asks the guest to stop with Firecracker's SendCtrlAltDel. On x86
# Firecracker has no ACPI power management, so a guest `poweroff` would halt
# the OS but leave the VMM alive; it exits on a CPU reset, which the kernel
# performs through the i8042 keyboard controller when the guest reboots with
# `reboot=k` (the box boot arg). Pin ctrl-alt-del.target explicitly to
# reboot.target — systemd's orderly shutdown followed by that reset — so a
# pause stops the VMM and the box does not come back up (M2 #48).
RUN ln -sf /usr/lib/systemd/system/reboot.target /etc/systemd/system/ctrl-alt-del.target

# The guest agent runs as the box user (a user unit), so it can manage the
# user systemd that supervises declared services. Linger starts it at boot.
COPY pluto-agent /usr/local/bin/pluto-agent
COPY pluto-agent.service /etc/systemd/user/pluto-agent.service
RUN mkdir -p /etc/systemd/user/default.target.wants \
 && ln -sf /etc/systemd/user/pluto-agent.service /etc/systemd/user/default.target.wants/pluto-agent.service

# Determinism cleanup: drop content that would otherwise vary with the build
# clock. Package postinsts append timestamped logs, and useradd/adduser stamp
# /etc/shadow with the current day. Logs are recreated at boot; the shadow day
# is pinned to the SOURCE_DATE_EPOCH day (a value derived from the apt snapshot
# pin, not the wall clock). ldconfig's aux-cache caches each library's mtime
# from the build clock, so it differs between otherwise identical builds; it is
# a cache and rebuilt on demand, so it is removed rather than normalized.
RUN rm -rf /var/log/* /var/log/journal \
 && rm -f /var/cache/ldconfig/aux-cache \
 && sed -i -E "s/^([^:]*:[^:]*:)[0-9]+:/\1$((SOURCE_DATE_EPOCH/86400)):/" /etc/shadow /etc/shadow-

CMD ["/bin/bash"]
